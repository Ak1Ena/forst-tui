{
  "name": "forst-tui",
  "version": "0.3.0",
  "description": "A powerful Node.js-based TUI wrapper for LLMs, built with LangChain and Ink.",
  "main": "dist/index.js",
  "bin": {
    "forst-tui": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --import tsx src/index.tsx",
    "build": "tsc",
    "postinstall": "node scripts/download-model.js",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "rebuild": "npm rebuild better-sqlite3 faiss-node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ak1Ena/forst-tui.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tui",
    "langchain",
    "ink",
    "ai",
    "agent",
    "llm",
    "terminal",
    "langgraph"
  ],
  "author": "Aki <poomzahathothai@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ak1Ena/forst-tui/issues"
  },
  "homepage": "https://github.com/Ak1Ena/forst-tui#readme",
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langchain/anthropic": "^1.3.27",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "better-sqlite3": "^12.9.0",
    "duck-duck-scrape": "^2.2.7",
    "faiss-node": "^0.5.1",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "langchain": "^1.3.4",
    "langsmith": "^0.5.25",
    "pickleparser": "^0.2.1",
    "react": "^19.2.5",
    "systeminformation": "^5.31.5",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
