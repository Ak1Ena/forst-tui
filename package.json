{
  "name": "forst-tui",
  "version": "0.1.0",
  "description": "A Node.js-based TUI wrapper for LLMs, built with LangChain and Ink.",
  "main": "dist/index.js",
  "bin": {
    "forst-tui": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "node --import tsx src/index.tsx",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "rebuild": "npm rebuild better-sqlite3 hnswlib-node"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ak1Ena/forst-tui.git"
  },
  "keywords": [
    "tui",
    "langchain",
    "ink",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ak1Ena/forst-tui/issues"
  },
  "homepage": "https://github.com/Ak1Ena/forst-tui#readme",
  "dependencies": {
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.41",
    "@langchain/google-genai": "^2.1.28",
    "@langchain/ollama": "^1.2.6",
    "@langchain/openai": "^1.4.4",
    "better-sqlite3": "^12.9.0",
    "duck-duck-scrape": "^2.2.7",
    "hnswlib-node": "^3.0.0",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "langchain": "^1.3.4",
    "react": "^19.2.5",
    "systeminformation": "^5.31.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
